<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-style inline="inline">
            h3 {
                font-size: 18px;
                color: #0a183c;
                font-weight: normal;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f6f8fb">
        <mj-section background-color="#011c50" padding="22px 24px">
            <mj-column>
                <mj-text align="center" color="#ffffff" font-size="24px" font-weight="800" letter-spacing="0.4px">
                    <span style="color:#fdba04">305</span> DISCOUNT
                </mj-text>
                <mj-text align="center" color="#dbeafe" font-size="12px" padding-top="0">
                    Furniture · Appliances · Mattresses · Miami, FL
                </mj-text>
            </mj-column>
        </mj-section>
