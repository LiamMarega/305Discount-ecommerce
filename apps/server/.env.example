# local: dev | production: production
APP_ENV=dev
NODE_ENV=development
PORT=3000

# Required in production. Generate strong values, do NOT reuse these defaults.
COOKIE_SECRET=change-me-with-openssl-rand-base64-32
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me
VENDURE_DISABLE_TELEMETRY=true

# Store mode vocabulary must stay aligned with the storefront:
# catalog | ecommerce
STORE_MODE=catalog

# Railway Postgres provides DATABASE_URL when you attach a Postgres service.
# Leave empty locally to use apps/server/vendure.sqlite.
# DATABASE_URL=postgresql://user:password@host:port/database
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Public backend URL used for asset URLs in production.
# Railway can infer this from RAILWAY_PUBLIC_DOMAIN, but explicit is better.
PUBLIC_URL=http://localhost:3000
ASSET_URL_PREFIX=http://localhost:3000/assets/

# Vercel storefront URL. Required for production CORS and email links.
STOREFRONT_URL=http://localhost:3001

# Optional SMTP. Without SMTP in production, email transport is no-op so deploys don't fail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=user
# SMTP_PASSWORD=password
# EMAIL_FROM_ADDRESS="easy-home-appliance" <noreply@example.com>
